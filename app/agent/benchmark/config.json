{
  "version": 2,
  "styles": ["en", "ar", "leb_arabizi", "mixed", "fr"],
  "minimum_style_cases": 30,
  "small_recall_n": 60,
  "maximum_miss_fraction": 0.05,
  "latency_warning_seconds": 15,
  "thresholds": {
    "intent_accuracy": {"overall": 0.90, "style": 0.85},
    "tool_accuracy": {"overall": 0.92, "style": 0.85},
    "tool_call_accuracy": {"overall": 0.90, "style": null},
    "escalation_recall": {"overall": 0.95, "style": 0.90},
    "must_escalate_recall": {"overall": 1.0, "style": 1.0},
    "escalation_precision": {"overall": 0.70, "style": null},
    "answer_rate": {"overall": 0.80, "style": null},
    "language_style_match": {"overall": 0.95, "style": 0.90},
    "unsafe_disclosures": {"overall": 0, "style": 0},
    "factual_inconsistencies": {"overall": 0, "style": 0}
  },
  "configurations": {
    "luna-none": {"model": "gpt-6-luna", "reasoning_effort": "none", "step_up": false},
    "luna-low": {"model": "gpt-6-luna", "reasoning_effort": "low", "step_up": false},
    "terra-low": {"model": "gpt-6.1-terra", "reasoning_effort": "low", "step_up": false},
    "sol-low": {"model": "gpt-6.2-sol", "reasoning_effort": "low", "step_up": false},
    "luna→sol": {"model": "gpt-6-luna", "reasoning_effort": "none", "step_up": true,
                 "step_up_model": "gpt-6.2-sol", "step_up_reasoning_effort": "low"}
  }
}
