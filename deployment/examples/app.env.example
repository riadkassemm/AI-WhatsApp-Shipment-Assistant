# Deployment overrides only. Preserve the rest of the existing private .env.
# The populated /etc/whatsapp-support/app.env is read by API and bridge services.
# Use KEY=value syntax compatible with systemd EnvironmentFile, not shell export.
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=REPLACE_WITH_ENVIRONMENT_DATABASE_NAME
DB_USER=REPLACE_WITH_APPLICATION_DATABASE_USER
DB_PASSWORD=REPLACE_PRIVATELY
REDIS_URL=redis://127.0.0.1:6379/0
SUPPORT_COOKIE_SECURE=true
SUPPORT_COOKIE_SAMESITE=strict
SUPPORT_MEDIA_DIRECTORY=/var/lib/whatsapp-support/support-media
WHATSAPP_TRANSPORT=cloud
WHATSAPP_LINKED_DEVICE_ENABLED=true
WHATSAPP_LINKED_DEVICE_URL=http://127.0.0.1:3001
WHATSAPP_LINKED_DEVICE_CALLBACK_URL=http://127.0.0.1:8000/api/whatsapp/linked-device/events
WHATSAPP_LINKED_DEVICE_DATA_DIRECTORY=/var/lib/whatsapp-support/linked-device
# Preserve WHATSAPP_LINKED_DEVICE_SECRET, configured line IDs, and all existing
# provider/authentication credentials from the current private configuration.
