[Unit]
Description=WhatsApp Support Linked Device Bridge
Wants=network-online.target
After=network-online.target whatsapp-api.service
PartOf=whatsapp-dev.target
StartLimitIntervalSec=0

[Service]
Type=exec
User=whatsapp-support
Group=whatsapp-support
WorkingDirectory=/opt/whatsapp-support/current/whatsapp_bridge
EnvironmentFile=/etc/whatsapp-support/app.env
# Replace this path with the actual installed Node.js 22+ binary.
ExecStart=/usr/bin/node /opt/whatsapp-support/current/whatsapp_bridge/src/index.js
Restart=always
RestartSec=5
TimeoutStopSec=35
UMask=0077
StateDirectory=whatsapp-support
StateDirectoryMode=0700
ReadWritePaths=/var/lib/whatsapp-support
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
CapabilityBoundingSet=
RestrictSUIDSGID=true
