[Unit]
Description=Daily isolated restore verification of the local Customer Support backup

[Timer]
# 03:30 Beirut (01:30 UTC in winter), outside staff hours. LocalBackupRestoreOverdue
# fires after 48 hours, so one missed run does not alert.
OnCalendar=*-*-* 01:30:00 UTC
RandomizedDelaySec=20m
Persistent=true

[Install]
WantedBy=timers.target
