[Unit]
Description=Daily isolated restore verification of the local Customer Support backup

[Timer]
# 03:30 Beirut local time all year (01:30 UTC in winter, 00:30 UTC in summer),
# outside staff hours; needs systemd >= 235 (production: 255). The 48-hour
# LocalBackupRestoreOverdue threshold tolerates one missed run.
OnCalendar=*-*-* 03:30:00 Asia/Beirut
RandomizedDelaySec=20m
Persistent=true

[Install]
WantedBy=timers.target
