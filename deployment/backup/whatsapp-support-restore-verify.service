[Unit]
Description=Verify that a local Customer Support backup restores in isolation
Documentation=file:///opt/whatsapp-support/current/docs/monitoring-identities-and-restore-production.txt
ConditionPathExists=/etc/whatsapp-support/cutover-approved
After=mariadb.service redis-server.service

[Service]
Type=oneshot
# Reads production MariaDB/Redis only; restores into throwaway socket-only
# instances under the private /var/tmp; refreshes the receipt only on success.
ExecStart=/usr/bin/python3 -B /usr/local/libexec/whatsapp-support/verify_local_backup_restore.py
Nice=10
IOSchedulingClass=idle
CPUQuota=100%
MemoryMax=2G
TimeoutStartSec=2h
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/backups/whatsapp-support /srv/migration/reports
