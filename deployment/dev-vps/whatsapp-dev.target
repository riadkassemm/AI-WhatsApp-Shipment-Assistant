[Unit]
Description=WhatsApp Support Development Stack
# Local MariaDB and Redis are shared dependencies. Their units deliberately
# have no PartOf relationship to this target and retain their existing lifecycle.
Wants=network-online.target mariadb.service shipment-redis.service shipment-bot.service whatsapp-bridge.service ngrok.service
After=network-online.target

[Install]
WantedBy=multi-user.target
