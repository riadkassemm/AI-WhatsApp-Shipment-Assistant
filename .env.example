```dotenv
# ============================================================
# OpenAI
# ============================================================

OPENAI_API_KEY=your_openai_api_key_here

OPENAI_MODEL=gpt-5.6
OPENAI_REASONING_EFFORT=medium

OPENAI_SUMMARIZER_REASONING_EFFORT=low
SUMMARIZER_MODEL=gpt-5.6

OPENAI_MAX_OUTPUT_TOKENS=1400


# ============================================================
# OpenAI abuse / wallet protection
# Rolling AI usage quotas
# ============================================================

AI_RATE_LIMIT_ENABLED=true

AI_RATE_LIMIT_TURNS_PER_MINUTE=6
AI_RATE_LIMIT_TURNS_PER_HOUR=30
AI_RATE_LIMIT_TURNS_PER_DAY=120

AI_RATE_LIMIT_GLOBAL_TURNS_PER_DAY=2000

AI_RATE_LIMIT_NOTICE_COOLDOWN_SECONDS=60

# Recommended for production:
# deny AI requests if quota storage/checking fails.
AI_RATE_LIMIT_FAIL_CLOSED=true


# ============================================================
# WhatsApp / Meta Cloud API
# ============================================================

WHATSAPP_TOKEN=your_meta_whatsapp_access_token_here

WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here

# Arbitrary private token used when Meta verifies the webhook.
WHATSAPP_VERIFY_TOKEN=replace_with_a_long_random_verify_token

WHATSAPP_API_VERSION=v20.0

# Meta App Secret used to verify webhook signatures.
WHATSAPP_APP_SECRET=your_meta_app_secret_here


# ============================================================
# MariaDB
# ============================================================
#
# Current development architecture:
#
# Application
#   -> 127.0.0.1:3307
#   -> SSH tunnel
#   -> remote MariaDB server 127.0.0.1:3306
#
# Do not expose MariaDB port 3306 publicly.
# ============================================================

DB_HOST=94.156.144.65
DB_PORT=3306

DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password

SHIPPING_DB_SCHEMA=shipping_db


# ============================================================
# Redis
# ============================================================
#
# Redis is required for coordinated queues, distributed locks,
# conversation state, and AI quota/rate-limit coordination.
# ============================================================

REDIS_URL=redis://127.0.0.1:6379/0

CONVERSATION_TTL_SECONDS=259200


# ============================================================
# WhatsApp message burst handling
# ============================================================

WHATSAPP_MESSAGE_BURST_DEBOUNCE_SECONDS=1.25
WHATSAPP_MESSAGE_BURST_MAX_WAIT_SECONDS=4.0
WHATSAPP_MESSAGE_BURST_MAX_MESSAGES=8


# ============================================================
# Shipping semantic normalizer
# ============================================================

SHIPPING_SEMANTIC_NORMALIZER_ENABLED=true

# Leave empty to use the application's default/fallback model.
SHIPPING_SEMANTIC_NORMALIZER_MODEL=

SHIPPING_SEMANTIC_NORMALIZER_TIMEOUT_SECONDS=10

SHIPPING_CATALOG_CACHE_SECONDS=60
SHIPPING_QUOTE_CONTEXT_TTL_SECONDS=1800


# ============================================================
# Support dashboard / session authentication
# ============================================================

SUPPORT_UI_ENABLED=true

SUPPORT_QUEUE_POLL_SECONDS=5

SUPPORT_SESSION_TTL_SECONDS=28800

SUPPORT_COOKIE_NAME=support_session
SUPPORT_CSRF_COOKIE_NAME=support_csrf

# Keep true in production when served over HTTPS.
SUPPORT_COOKIE_SECURE=true

SUPPORT_COOKIE_SAMESITE=strict

SUPPORT_LOGIN_MAX_FAILURES=5
SUPPORT_LOGIN_LOCK_SECONDS=900


# ============================================================
# Human support / handoff
# ============================================================

# Optional external webhook.
# Leave empty if unused.
HUMAN_HANDOFF_WEBHOOK_URL=

HUMAN_MODE_TIMEOUT_SECONDS=1800


# ============================================================
# Support media storage
# ============================================================

# Prefer an absolute path in production/systemd deployments.
# Example:
# SUPPORT_MEDIA_DIRECTORY=/var/lib/whatsapp-chatbot/support_media
#
# A shell-style "~" may not be expanded by every Python library
# or service manager unless your application expands it itself.
SUPPORT_MEDIA_DIRECTORY=/var/lib/whatsapp-chatbot/support_media


# ============================================================
# Conversation limits
# ============================================================

MAX_CONVERSATION_MESSAGES=20


# ============================================================
# Logging
# ============================================================

LOG_LEVEL=INFO
```
